{
  "name": "hub-preview-studio",
  "version": "0.1.1",
  "description": "Independent local phone and 576x288 glasses preview tool for Even Hub projects",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hub-preview-studio": "bin/cli.mjs"
  },
  "exports": {
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./protocol": "./lib/protocol.js"
  },
  "files": [
    "bin",
    "lib",
    "web",
    "examples",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/cli.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "author": "zijiebuzhuang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zijiebuzhuang/hub-preview-studio.git"
  },
  "homepage": "https://github.com/zijiebuzhuang/hub-preview-studio#readme",
  "bugs": {
    "url": "https://github.com/zijiebuzhuang/hub-preview-studio/issues"
  },
  "keywords": [
    "even-hub",
    "even-realities",
    "g2",
    "developer-tools",
    "preview"
  ]
}
